# AMO (addons.mozilla.org) API credentials for `pnpm sign:firefox`.
# Copy this file to .env.local (git-ignored) and fill in both values.
# Get them at https://addons.mozilla.org/developers/addon/api/key/
# Never commit .env.local or paste these values anywhere public.

# "JWT issuer", shaped like user:12345678:123
WEB_EXT_API_KEY=
# "JWT secret" (a long hex string)
WEB_EXT_API_SECRET=
